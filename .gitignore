{
  "rules": {
    "songs": {
      ".read": true,
      ".write": false,
      ".indexOn": ["title", "artist"]
    },
    "requests": {
      ".read": true,
      ".write": true,
      "$requestId": {
        ".validate": "newData.hasChildren(['songId', 'songTitle', 'timestamp', 'paymentMethod', 'status']) && newData.child('timestamp').isNumber() && newData.child('status').isString()"
      }
    },
    "settings": {
      ".read": true,
      ".write": false
    },
    "playedHistory": {
      ".read": true,
      ".write": false
    }
  }
}

// EXPLANATION OF RULES:
// ======================

// "songs": 
//   - Anyone can READ (customers need to see song list)
//   - NO ONE can WRITE from apps (you manually add songs in Firebase Console)
//   - This prevents customers from adding fake songs

// "requests":
//   - Anyone can READ (all apps need to see the queue)
//   - Anyone can WRITE (customers submit requests)
//   - Validation ensures requests have required fields
//   - This allows the app to function but validates data structure

// "settings":
//   - Anyone can READ (apps need priority boost price, Venmo info)
//   - NO ONE can WRITE from apps (you change settings in Firebase Console only)
//   - This prevents customers from changing prices

// "playedHistory":
//   - Anyone can READ (for future analytics/reports)
//   - NO ONE can WRITE from apps
//   - Only written to through Admin SDK or Console

// WHY THIS IS SECURE:
// - Customers can't modify song prices
// - Customers can't delete other people's requests (use Admin SDK for that)
// - Settings are locked down
// - Data structure is validated

// LIMITATION:
// Currently, anyone can write ANY request. In production, you may want
// to add rate limiting or authentication. But for a live jukebox at events,
// this is acceptable since the manager manually confirms payments anyway.
