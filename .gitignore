# ==========================================
# NEVER commit your actual Firebase keys!
firebaseConfig.js
.env
.env.local
.env.production

# ==========================================
# Dependencies
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ==========================================
# React Native / Expo
# ==========================================
.expo/
.expo-shared/
dist/
web-build/

# ==========================================
# iOS
# ==========================================
ios/Pods/
ios/build/
*.xcworkspace
*.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ==========================================
# Android
# ==========================================
android/app/build/
android/build/
android/.gradle/
*.apk
*.aab
local.properties
*.jks
*.keystore

# ==========================================
# macOS
# ==========================================
.DS_Store
.AppleDouble
.LSOverride

# ==========================================
# Windows
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# Linux
# ==========================================
*~

# ==========================================
# IDEs and Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*.log
*.sublime-project
*.sublime-workspace

# ==========================================
# Testing
# ==========================================
coverage/
.nyc_output/

# ==========================================
# Temporary files
# ==========================================
*.tmp
*.temp
.cache///   - Validation ensures requests have required fields
//   - This allows the app to function but validates data structure

// "settings":
//   - Anyone can READ (apps need priority boost price, Venmo info)
//   - NO ONE can WRITE from apps (you change settings in Firebase Console only)
//   - This prevents customers from changing prices

// "playedHistory":
//   - Anyone can READ (for future analytics/reports)
//   - NO ONE can WRITE from apps
//   - Only written to through Admin SDK or Console

// WHY THIS IS SECURE:
// - Customers can't modify song prices
// - Customers can't delete other people's requests (use Admin SDK for that)
// - Settings are locked down
// - Data structure is validated

// LIMITATION:
// Currently, anyone can write ANY request. In production, you may want
// to add rate limiting or authentication. But for a live jukebox at events,
// this is acceptable since the manager manually confirms payments anyway.
